	column 'Day Type' = IF ( RELATED ( 'Date'[is_weekend] ), "Weekend", "Weekday" )
		dataType: string
		lineageTag: 00f32c5c-4054-4a75-8ec2-cf65209a2fa3
		summarizeBy: none

	partition 'Daily Sales' = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "fact_daily_sales.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"store_id", Int64.Type}, {"date_id", Int64.Type}, {"product_id", Int64.Type}, {"total_revenue_gbp", type number}, {"total_transactions", type number}, {"avg_transaction_value_gbp", type number}, {"loyalty_transactions", type number}, {"loyalty_redemption_cost_gbp", type number}, {"footfall", type number}, {"espresso_revenue_gbp", type number}, {"filter_revenue_gbp", type number}, {"food_revenue_gbp", type number}, {"retail_beans_revenue_gbp", type number}, {"daily_gross_profit_gbp", type number}, {"staff_count", type number}, {"total_staff_hours", type number}, {"avg_dwell_time_minutes", type number}})
				    ,
				    // The daily table holds 1,090 duplicated store-days with conflicting values.
				    // Average them so each store-day counts once (documented in the data-quality notes).
				    Grouped = Table.Group(
				        Typed,
				        {"store_id", "date_id"},
				        {
				            {"product_id", each List.Max([product_id]), Int64.Type},
				            {"total_revenue_gbp", each List.Average([total_revenue_gbp]), type number},
				            {"total_transactions", each List.Average([total_transactions]), type number},
				            {"avg_transaction_value_gbp", each List.Average([avg_transaction_value_gbp]), type number},
				            {"loyalty_transactions", each List.Average([loyalty_transactions]), type number},
				            {"loyalty_redemption_cost_gbp", each List.Average([loyalty_redemption_cost_gbp]), type number},
				            {"footfall", each List.Average([footfall]), type number},
				            {"espresso_revenue_gbp", each List.Average([espresso_revenue_gbp]), type number},
				            {"filter_revenue_gbp", each List.Average([filter_revenue_gbp]), type number},
				            {"food_revenue_gbp", each List.Average([food_revenue_gbp]), type number},
				            {"retail_beans_revenue_gbp", each List.Average([retail_beans_revenue_gbp]), type number},
				            {"daily_gross_profit_gbp", each List.Average([daily_gross_profit_gbp]), type number},
				            {"staff_count", each List.Average([staff_count]), type number},
				            {"total_staff_hours", each List.Average([total_staff_hours]), type number},
				            {"avg_dwell_time_minutes", each List.Average([avg_dwell_time_minutes]), type number}
				        }
				    )
				in
				    Grouped

	annotation PBI_ResultType = Table

