	measure 'KPI Store Months Losing Money' = FORMAT ( [Months Losing Money per Store], "0" ) & " of 24"
		displayFolder: KPI cards
		lineageTag: cb0c8f19-76e2-40be-a35b-4cf0e7776b84

	measure 'Site Pressure SVG' = ```
			
			VAR _yr = IF ( HASONEVALUE ( 'Date'[year] ), FORMAT ( VALUES ( 'Date'[year] ), "0" ), "2023–24" )
			VAR _stores =
			    
			CALCULATETABLE ( VALUES ( 'Store'[store_id] ), 'Monthly Profit' )
			VAR _total = COUNTROWS ( _stores ) + 0
			VAR _rent = CALCULATE ( [Stores Over 10% Rent] )
			VAR _margin = CALCULATE ( [Stores Under 8% Margin] )
			VAR _months =
			    
			COUNTROWS (
			        
			FILTER (
			            
			_stores,
			            
			CALCULATE (
			                
			COUNTROWS ( 'Monthly Profit' ),
			                
			'Monthly Profit'[net_profit_margin_pct] < -0.02
			            
			) >= 6
			        
			)
			    
			) + 0
			VAR _losingTbl =
			    
			FILTER ( _stores, CALCULATE ( [Net Profit] ) < 0 )
			VAR _losing = COUNTROWS ( _losingTbl ) + 0
			VAR _loserName =
			    
			IF (
			        
			_losing = 1,
			        
			CALCULATE ( MAX ( 'Store'[store_name] ), _losingTbl, REMOVEFILTERS ( 'Store' ) )
			    
			)
			VAR _w = 412
			VAR _w1 = IF ( _total > 0, ROUND ( _w * _rent / _total, 1 ), 0 )
			VAR _w2 = IF ( _total > 0, ROUND ( _w * _margin / _total, 1 ), 0 )
			VAR _w3 = IF ( _total > 0, ROUND ( _w * _months / _total, 1 ), 0 )
			VAR _w4 = IF ( _total > 0, ROUND ( _w * _losing / _total, 1 ), 0 )
			VAR _p1 = FORMAT ( DIVIDE ( _rent, _total, 0 ) * 100, "0" ) & "%25 of stores"
			VAR _p2 = FORMAT ( DIVIDE ( _margin, _total, 0 ) * 100, "0" ) & "%25 of stores"
			VAR _p3 = FORMAT ( DIVIDE ( _months, _total, 0 ) * 100, "0" ) & "%25 of stores"
			VAR _p4 =
			    
			IF (
			        
			_losing = 1,
			        
			SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _loserName, "&", "&amp;" ), "<", "&lt;" ), "#", "%23" ),
			        
			FORMAT ( DIVIDE ( _losing, _total, 0 ) * 100, "0" ) & "%25 of stores"
			    
			)
			VAR _font = "font-family='Segoe UI, Arial, sans-serif'"
			VAR _row1 = 100
			VAR _row2 = 175
			VAR _row3 = 250
			VAR _row4 = 325
			VAR _svg =
			    
			"<svg xmlns='http://www.w3.org/2000/svg' width='460' height='400' viewBox='0 0 460 400' " & _font & ">"
			        
			& "<rect x='0.5' y='0.5' width='459' height='399' rx='12' ry='12' fill='%23FFFFFF' stroke='%23E8E0D8' stroke-width='1'/>"
			        
			& "<text x='24' y='38' font-size='20' font-weight='700' fill='%232B1D14'>Site Pressure</text>"
			        
			& "<text x='24' y='60' font-size='13' font-style='italic' fill='%238A7F76'>Where rent is squeezing profit</text>"
			        
			-- Row 1
			        
			& "<text x='24' y='" & _row1 & "' font-size='14' font-weight='700' fill='%232B1D14'>Stores over 10%25 rent</text>"
			        
			& "<text x='436' y='" & _row1 & "' font-size='16' font-weight='700' fill='%232B1D14' text-anchor='end'>" & _rent & "</text>"
			        
			& "<rect x='24' y='" & _row1 + 12 & "' width='412' height='10' rx='5' fill='%23EFE4D8'/>"
			        
			& "<rect x='24' y='" & _row1 + 12 & "' width='" & _w1 & "' height='10' rx='5' fill='%23C4861E'/>"
			        
			& "<text x='24' y='" & _row1 + 42 & "' font-size='11' fill='%238A7F76'>Rent pressure</text>"
			        
			& "<text x='436' y='" & _row1 + 42 & "' font-size='11' fill='%238A7F76' text-anchor='end'>" & _p1 & "</text>"
			        
			-- Row 2
			        
			& "<text x='24' y='" & _row2 & "' font-size='14' font-weight='700' fill='%232B1D14'>Margin under 8%25</text>"
			        
			& "<text x='436' y='" & _row2 & "' font-size='16' font-weight='700' fill='%232B1D14' text-anchor='end'>" & _margin & "</text>"
			        
			& "<rect x='24' y='" & _row2 + 12 & "' width='412' height='10' rx='5' fill='%23EFE4D8'/>"
			        
			& "<rect x='24' y='" & _row2 + 12 & "' width='" & _w2 & "' height='10' rx='5' fill='%23B5432F'/>"
			        
			& "<text x='24' y='" & _row2 + 42 & "' font-size='11' fill='%238A7F76'>Profit pressure</text>"
			        
			& "<text x='436' y='" & _row2 + 42 & "' font-size='11' fill='%238A7F76' text-anchor='end'>" & _p2 & "</text>"
			        
			-- Row 3
			        
			& "<text x='24' y='" & _row3 & "' font-size='14' font-weight='700' fill='%232B1D14'>Lost money in 6+ months</text>"
			        
			& "<text x='436' y='" & _row3 & "' font-size='16' font-weight='700' fill='%232B1D14' text-anchor='end'>" & _months & "</text>"
			        
			& "<rect x='24' y='" & _row3 + 12 & "' width='412' height='10' rx='5' fill='%23EFE4D8'/>"
			        
			& "<rect x='24' y='" & _row3 + 12 & "' width='" & _w3 & "' height='10' rx='5' fill='%23C4861E'/>"
			        
			& "<text x='24' y='" & _row3 + 42 & "' font-size='11' fill='%238A7F76'>Consistency</text>"
			        
			& "<text x='436' y='" & _row3 + 42 & "' font-size='11' fill='%238A7F76' text-anchor='end'>" & _p3 & "</text>"
			        
			-- Row 4
			        
			& "<text x='24' y='" & _row4 & "' font-size='14' font-weight='700' fill='%232B1D14'>Losing money in " & _yr & "</text>"
			        
			& "<text x='436' y='" & _row4 & "' font-size='16' font-weight='700' fill='%232B1D14' text-anchor='end'>" & _losing & "</text>"
			        
			& "<rect x='24' y='" & _row4 + 12 & "' width='412' height='10' rx='5' fill='%23EFE4D8'/>"
			        
			& "<rect x='24' y='" & _row4 + 12 & "' width='" & _w4 & "' height='10' rx='5' fill='%23B5432F'/>"
			        
			& "<text x='24' y='" & _row4 + 42 & "' font-size='11' fill='%238A7F76'>Exit risk</text>"
			        
			& "<text x='436' y='" & _row4 + 42 & "' font-size='11' fill='%238A7F76' text-anchor='end'>" & _p4 & "</text>"
			        
			& "</svg>"
			RETURN
			    
			"data:image/svg+xml;utf8," & _svg
			
			```
		lineageTag: 2d88fc9f-ad5a-47e6-81f4-e23f25d951f0
		dataCategory: ImageUrl

	measure 'Price Label' = FORMAT ( [Price List Margin], "0" ) & "p"
		lineageTag: 5722eea6-74fd-4407-becf-e7a13a7529c5

	measure 'Kept Label' = FORMAT ( [Realised Margin], "0" ) & "p"
		lineageTag: cc8d7138-9ca8-47a9-b52d-7c32d3b018cb

	measure 'Ring Net Margin' = ```
			
			VAR v = [Net Margin]
			VAR fill = MIN ( 1, MAX ( 0, DIVIDE ( v, 0.30 ) ) )
			VAR col =
			    
			SWITCH ( TRUE (), v >= 0.19, "%233D8B67", v >= 0.10, "%23C08419", "%23B4442E" )
			VAR circ = 2 * PI () * 80
			VAR dash = FORMAT ( fill * circ, "0.00" )
			VAR txt = FORMAT ( v * 100, "0.0" ) & "%25"
			VAR svg =
			    
			"<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200' viewBox='0 0 200 200'>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='%23EFE4D8' stroke-width='14'/>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='" & col & "' stroke-width='14' stroke-linecap='round'"
			        
			& " stroke-opacity='" & IF ( fill > 0, "1", "0" ) & "'"
			        
			& " stroke-dasharray='" & dash & " " & FORMAT ( circ, "0.00" ) & "' transform='rotate(-90 100 100)'/>"
			        
			& "<text x='100' y='100' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI' font-size='34' font-weight='bold' fill='%232B1E16'>" & txt & "</text>"
			        
			& "<text x='100' y='130' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='%237A6A5D'>Net margin</text>"
			        
			& "</svg>"
			RETURN
			    
			"data:image/svg+xml;utf8," & svg
			
			```
		lineageTag: aa1664a5-42fc-4469-a081-e974d2732be0
		dataCategory: ImageUrl

	measure 'Ring Rent' = ```
			
			VAR v = [Rent % of Sales]
			VAR fill = MIN ( 1, MAX ( 0, DIVIDE ( v, 0.25 ) ) )
			VAR col =
			    
			SWITCH ( TRUE (), v < 0.10, "%233D8B67", v < 0.15, "%23C08419", "%23B4442E" )
			VAR circ = 2 * PI () * 80
			VAR dash = FORMAT ( fill * circ, "0.00" )
			VAR txt = FORMAT ( v * 100, "0.0" ) & "%25"
			VAR svg =
			    
			"<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200' viewBox='0 0 200 200'>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='%23EFE4D8' stroke-width='14'/>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='" & col & "' stroke-width='14' stroke-linecap='round'"
			        
			& " stroke-opacity='" & IF ( fill > 0, "1", "0" ) & "'"
			        
			& " stroke-dasharray='" & dash & " " & FORMAT ( circ, "0.00" ) & "' transform='rotate(-90 100 100)'/>"
			        
			& "<text x='100' y='100' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI' font-size='34' font-weight='bold' fill='%232B1E16'>" & txt & "</text>"
			        
			& "<text x='100' y='130' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='%237A6A5D'>Rent of sales</text>"
			        
			& "</svg>"
			RETURN
			    
			"data:image/svg+xml;utf8," & svg
			```
		lineageTag: acb81c39-4f5f-4848-9ea4-51b5eeb297ca
		dataCategory: ImageUrl

	measure 'Ring Loyalty' = ```
			
			VAR v = [Customers in Scheme]
			VAR fill = MIN ( 1, MAX ( 0, v ) )
			VAR col = "%236F4E37"
			VAR circ = 2 * PI () * 80
			VAR dash = FORMAT ( fill * circ, "0.00" )
			VAR txt = FORMAT ( v * 100, "0" ) & "%25"
			VAR svg =
			    
			"<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200' viewBox='0 0 200 200'>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='%23EFE4D8' stroke-width='14'/>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='" & col & "' stroke-width='14' stroke-linecap='round'"
			        
			& " stroke-opacity='" & IF ( fill > 0, "1", "0" ) & "'"
			        
			& " stroke-dasharray='" & dash & " " & FORMAT ( circ, "0.00" ) & "' transform='rotate(-90 100 100)'/>"
			        
			& "<text x='100' y='100' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI' font-size='34' font-weight='bold' fill='%232B1E16'>" & txt & "</text>"
			        
			& "<text x='100' y='130' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='%237A6A5D'>Loyalty adoption</text>"
			        
			& "</svg>"
			RETURN
			    
			"data:image/svg+xml;utf8," & svg
			```
		lineageTag: 6fb56f6a-e1e2-43e4-b5c3-76e09abdfd3a
		dataCategory: ImageUrl

	measure 'Ring Months' = ```
			
			VAR m = [Months in Profit per Store]
			VAR total = DIVIDE ( COUNTROWS ( 'Monthly Profit' ), [Store Count] )
			VAR fill = MIN ( 1, MAX ( 0, DIVIDE ( m, total ) ) )
			VAR col =
			    
			SWITCH ( TRUE (), m >= 18, "%233D8B67", m >= 12, "%23C08419", "%23B4442E" )
			VAR circ = 2 * PI () * 80
			VAR dash = FORMAT ( fill * circ, "0.00" )
			VAR txt = FORMAT ( m, "0" ) & "/" & FORMAT ( total, "0" )
			VAR svg =
			    
			"<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200' viewBox='0 0 200 200'>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='%23EFE4D8' stroke-width='14'/>"
			        
			& "<circle cx='100' cy='100' r='80' fill='none' stroke='" & col & "' stroke-width='14' stroke-linecap='round'"
			        
			& " stroke-opacity='" & IF ( fill > 0, "1", "0" ) & "'"
			        
			& " stroke-dasharray='" & dash & " " & FORMAT ( circ, "0.00" ) & "' transform='rotate(-90 100 100)'/>"
			        
			& "<text x='100' y='100' text-anchor='middle' dominant-baseline='middle' font-family='Segoe UI' font-size='34' font-weight='bold' fill='%232B1E16'>" & txt & "</text>"
			        
			& "<text x='100' y='130' text-anchor='middle' font-family='Segoe UI' font-size='14' fill='%237A6A5D'>Months in profit</text>"
			        
			& "</svg>"
			RETURN
			    
			"data:image/svg+xml;utf8," & svg
			```
		lineageTag: 336ad424-9531-4d00-9193-38396e9eeab9
		dataCategory: ImageUrl

	measure 'Store Profile SVG' = ```
			
			VAR _isone = HASONEVALUE ( 'Store'[store_name] )
			VAR _rawname   = SELECTEDVALUE ( 'Store'[store_name], "Select a store" )
			VAR _rawregion = SUBSTITUTE ( SELECTEDVALUE ( 'Store'[region], "-" ), "-", " " )
			VAR _rawloc    = SUBSTITUTE ( SELECTEDVALUE ( 'Store'[location_type], "-" ), "-", " " )
			VAR _rawcity   = SELECTEDVALUE ( 'Store'[city], "-" )
			VAR _rawformat = SUBSTITUTE ( SELECTEDVALUE ( 'Store'[store_format], "-" ), "-", " " )
			VAR _rawstatus = SELECTEDVALUE ( 'Store'[store_status], "-" )
			VAR _rawrentl  = SELECTEDVALUE ( 'Store'[Rent Level], "-" )
			VAR _rentclean = IF ( MID ( _rawrentl, 2, 2 ) = ". ", MID ( _rawrentl, 4, 100 ), _rawrentl )
			VAR _staff     = SELECTEDVALUE ( 'Store'[staff_headcount] )
			VAR _opened    = SELECTEDVALUE ( 'Store'[opening_year] )
			VAR _seats     = SELECTEDVALUE ( 'Store'[seating_capacity] )
			VAR _review    = SELECTEDVALUE ( 'Store'[Review Status], "-" )
			VAR _onlist    = IF ( OR ( _review = "Review", _review = "Losing money" ), "Yes", "No" )
			VAR _action    =
			    
			SWITCH ( _review,
			        
			"Losing money", "Consider exit or close",
			        
			"Review", "Review performance",
			        
			"Healthy", "Keep and grow",
			        
			"-" )
			VAR _tname   = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rawname,   "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "%", "%25" ), "#", "%23" )
			VAR _tregion = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rawregion, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "%", "%25" ), "#", "%23" )
			VAR _tloc    = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rawloc,    "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "%", "%25" ), "#", "%23" )
			VAR _tcity   = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rawcity,   "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "%", "%25" ), "#", "%23" )
			VAR _tformat = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rawformat, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "%", "%25" ), "#", "%23" )
			VAR _tstatus = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rawstatus, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "%", "%25" ), "#", "%23" )
			VAR _trent   = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _rentclean, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "%", "%25" ), "#", "%23" )
			VAR _tstaff  = IF ( ISBLANK ( _staff ), "-", FORMAT ( _staff, "0" ) & " people" )
			VAR _topened = IF ( ISBLANK ( _opened ), "-", FORMAT ( _opened, "0" ) )
			VAR _tseats  = IF ( ISBLANK ( _seats ), "-", FORMAT ( _seats, "0" ) )
			VAR _actlower = LOWER ( _action )
			VAR _actbg  = IF ( CONTAINSSTRING ( _actlower, "exit" ) || CONTAINSSTRING ( _actlower, "close" ), "%23F6DCD6",
			             
			IF ( CONTAINSSTRING ( _actlower, "review" ), "%23F7EBD3", "%23DCEFE4" ) )
			VAR _actfg  = IF ( _actbg = "%23F6DCD6", "%23B4442E", IF ( _actbg = "%23F7EBD3", "%23C08419", "%233D8B67" ) )
			VAR _stbg   = IF ( _rawstatus = "Active", "%23DCEFE4", "%23F7EBD3" )
			VAR _stfg   = IF ( _rawstatus = "Active", "%233D8B67", "%23C08419" )
			VAR _rvbg   = IF ( _onlist = "Yes", "%23F7EBD3", "%23DCEFE4" )
			VAR _rvfg   = IF ( _onlist = "Yes", "%23C08419", "%233D8B67" )
			VAR _lx = 18
			VAR _rx = 226
			VAR _w  = 190
			VAR _y0 = 78
			VAR _p  = 44
			VAR _labelsty = " font-size='10' fill='%237A6A5D' letter-spacing='0.6'>"
			VAR _valsty   = " font-size='13' font-weight='700' fill='%232B1E16'>"
			VAR _leftrows =
			    
			"<text x='" & _lx & "' y='" & _y0 & "'" & _labelsty & "STORE</text>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 18 & "'" & _valsty & _tname & "</text>"
			    
			& "<line x1='" & _lx & "' x2='" & _lx + _w & "' y1='" & _y0 + 28 & "' y2='" & _y0 + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + _p & "'" & _labelsty & "REGION</text>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + _p + 18 & "'" & _valsty & _tregion & "</text>"
			    
			& "<line x1='" & _lx & "' x2='" & _lx + _w & "' y1='" & _y0 + _p + 28 & "' y2='" & _y0 + _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 2 * _p & "'" & _labelsty & "LOCATION TYPE</text>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 2 * _p + 18 & "'" & _valsty & _tloc & "</text>"
			    
			& "<line x1='" & _lx & "' x2='" & _lx + _w & "' y1='" & _y0 + 2 * _p + 28 & "' y2='" & _y0 + 2 * _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 3 * _p & "'" & _labelsty & "CITY</text>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 3 * _p + 18 & "'" & _valsty & _tcity & "</text>"
			    
			& "<line x1='" & _lx & "' x2='" & _lx + _w & "' y1='" & _y0 + 3 * _p + 28 & "' y2='" & _y0 + 3 * _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 4 * _p & "'" & _labelsty & "STAFF</text>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 4 * _p + 18 & "'" & _valsty & _tstaff & "</text>"
			    
			& "<line x1='" & _lx & "' x2='" & _lx + _w & "' y1='" & _y0 + 4 * _p + 28 & "' y2='" & _y0 + 4 * _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 5 * _p & "'" & _labelsty & "RENT LEVEL</text>"
			    
			& "<text x='" & _lx & "' y='" & _y0 + 5 * _p + 18 & "'" & _valsty & _trent & "</text>"
			    
			& "<line x1='" & _lx & "' x2='" & _lx + _w & "' y1='" & _y0 + 5 * _p + 28 & "' y2='" & _y0 + 5 * _p + 28 & "' stroke='%23EFE4D8'/>"
			VAR _pilla = "<rect x='" & _rx & "' y='" & _y0 + 5 & "' width='" & 7 * LEN ( _action ) + 16 & "' height='19' rx='9' fill='" & _actbg & "'/>"
			    
			& "<text x='" & _rx + 8 & "' y='" & _y0 + 18 & "' font-size='12' font-weight='700' fill='" & _actfg & "'>" & _action & "</text>"
			VAR _pills = "<rect x='" & _rx & "' y='" & _y0 + _p + 5 & "' width='" & 7 * LEN ( _rawstatus ) + 16 & "' height='19' rx='9' fill='" & _stbg & "'/>"
			    
			& "<text x='" & _rx + 8 & "' y='" & _y0 + _p + 18 & "' font-size='12' font-weight='700' fill='" & _stfg & "'>" & _tstatus & "</text>"
			VAR _pillr = "<rect x='" & _rx & "' y='" & _y0 + 5 * _p + 5 & "' width='" & 7 * LEN ( _onlist ) + 16 & "' height='19' rx='9' fill='" & _rvbg & "'/>"
			    
			& "<text x='" & _rx + 8 & "' y='" & _y0 + 5 * _p + 18 & "' font-size='12' font-weight='700' fill='" & _rvfg & "'>" & _onlist & "</text>"
			VAR _rightrows =
			    
			"<text x='" & _rx & "' y='" & _y0 & "'" & _labelsty & "RECOMMENDED ACTION</text>" & _pilla
			    
			& "<line x1='" & _rx & "' x2='" & _rx + _w & "' y1='" & _y0 + 28 & "' y2='" & _y0 + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + _p & "'" & _labelsty & "STATUS</text>" & _pills
			    
			& "<line x1='" & _rx & "' x2='" & _rx + _w & "' y1='" & _y0 + _p + 28 & "' y2='" & _y0 + _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + 2 * _p & "'" & _labelsty & "FORMAT</text>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + 2 * _p + 18 & "'" & _valsty & _tformat & "</text>"
			    
			& "<line x1='" & _rx & "' x2='" & _rx + _w & "' y1='" & _y0 + 2 * _p + 28 & "' y2='" & _y0 + 2 * _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + 3 * _p & "'" & _labelsty & "OPENED</text>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + 3 * _p + 18 & "'" & _valsty & _topened & "</text>"
			    
			& "<line x1='" & _rx & "' x2='" & _rx + _w & "' y1='" & _y0 + 3 * _p + 28 & "' y2='" & _y0 + 3 * _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + 4 * _p & "'" & _labelsty & "SEATS</text>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + 4 * _p + 18 & "'" & _valsty & _tseats & "</text>"
			    
			& "<line x1='" & _rx & "' x2='" & _rx + _w & "' y1='" & _y0 + 4 * _p + 28 & "' y2='" & _y0 + 4 * _p + 28 & "' stroke='%23EFE4D8'/>"
			    
			& "<text x='" & _rx & "' y='" & _y0 + 5 * _p & "'" & _labelsty & "REVIEW LIST</text>" & _pillr
			    
			& "<line x1='" & _rx & "' x2='" & _rx + _w & "' y1='" & _y0 + 5 * _p + 28 & "' y2='" & _y0 + 5 * _p + 28 & "' stroke='%23EFE4D8'/>"
			VAR _header =
			    
			"<svg xmlns='http://www.w3.org/2000/svg' width='440' height='390' viewBox='0 0 440 390' font-family='Segoe UI, sans-serif'>"
			    
			& "<rect x='0.5' y='0.5' width='439' height='389' rx='12' fill='%23FFFFFF' stroke='%23E8E0D8'/>"
			    
			& "<text x='18' y='30' font-size='15' font-weight='700' fill='%232B1E16' letter-spacing='0.5'>STORE PROFILE</text>"
			    
			& "<text x='18' y='48' font-size='12' fill='%237A6A5D'>Key store information</text>"
			VAR _body =
			    
			IF ( _isone, _leftrows & _rightrows,
			        
			"<text x='220' y='200' font-size='14' font-weight='700' fill='%237A6A5D' text-anchor='middle'>Select a store</text>" )
			RETURN
			    
			"data:image/svg+xml;utf8," & _header & _body & "</svg>"
			```
		lineageTag: f412498d-a05b-4b3d-93e6-6bb556ce6ec9
		dataCategory: ImageUrl

	measure 'Typical Store Selected' =
			
			CALCULATE (
			    MEDIANX ( VALUES ( 'Store'[store_id] ), [Selected Measure] ),
			    REMOVEFILTERS ( 'Store' )
			)
		lineageTag: 0308a2ba-80c0-4cb9-b9c2-67504228db09

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Measure Choice'[Measure Choice] ) = "Net Margin", "0.0%", "£#,0" )

	measure 'Weekday Sales' = IF ( MAX ( 'Date'[Day Number] ) <= 5, [Sales Index vs Average Day] )
		lineageTag: 2e30bca0-b093-4f76-8795-91762b9283f1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekend Sales' = IF ( MAX ( 'Date'[Day Number] ) >= 6, [Sales Index vs Average Day] )
		lineageTag: 0369612f-fbda-4242-b260-e715f5dd22eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Margin Note vs 2023' =
			
			VAR Diff = ( [Net Margin 2024] - [Net Margin 2023] ) * 100
			RETURN
			    IF ( Diff >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Diff ), "0.0" ) & " points vs 2023"
		lineageTag: 7d0c6caa-2b5e-453e-8914-1f90d1974c61

	measure 'Margin Note Colour' = IF ( [Net Margin 2024] >= [Net Margin 2023], "#3D8B67", "#B4442E" )
		lineageTag: ee4d9fed-e635-415d-84fe-da55fe4f4ce4

	column 'Measures Placeholder'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8daaa2ff-964d-4c44-bf2e-2636e63d6173
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Key Measures' = calculated
		mode: import
		source = ROW ( "Value", 1 )

