	/// Blank when the data has no earlier year to compare with.
	measure 'Year Sales Change %' =
			VAR Prior = [Prior Year Sales]
			RETURN IF ( ISBLANK ( Prior ), BLANK (), DIVIDE ( [Year Sales] - Prior, Prior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Selected year
		lineageTag: f0ed4b66-8fb9-40a7-b9c7-4f93e3bc4ab1

	/// Blank when the data has no earlier year to compare with.
	measure 'Year Net Profit Change %' =
			VAR Prior = [Prior Year Net Profit]
			RETURN IF ( ISBLANK ( Prior ), BLANK (), DIVIDE ( [Year Net Profit] - Prior, Prior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Selected year
		lineageTag: 7ebd664e-1e46-4d11-9f46-732a2e3007b0

	measure 'Year Margin Change pts' =
			VAR Prior = [Prior Year Net Margin]
			RETURN IF ( ISBLANK ( Prior ), BLANK (), ( [Year Net Margin] - Prior ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: Selected year
		lineageTag: d0733157-dc03-4424-8782-136994c17356

	/// Average yearly profit of one store over the months in view.
	measure 'Profit per Store per Year' = DIVIDE ( DIVIDE ( [Net Profit], [Store Count] ), DIVIDE ( DISTINCTCOUNT ( 'Monthly Profit'[month_id] ), 12 ) )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Stores
		lineageTag: f2a44c2b-b5c3-4c0c-b250-d259b2d5810a

	measure 'Months in Profit per Store' = DIVIDE ( CALCULATE ( COUNTROWS ( 'Monthly Profit' ), 'Monthly Profit'[net_profit_gbp] > 0 ), [Store Count] )
		formatString: #,0.0
		displayFolder: Stores
		lineageTag: 8a562788-7f10-4178-9c10-4204be12c819

	/// Pence per £1 the price list implies, weighted by what each product line actually sells.
	measure 'Price List Margin Weighted' =
			VAR Espresso = SUM ( 'Daily Sales'[espresso_revenue_gbp] )
			VAR FilterCoffee = SUM ( 'Daily Sales'[filter_revenue_gbp] )
			VAR Food = SUM ( 'Daily Sales'[food_revenue_gbp] )
			VAR Beans = SUM ( 'Daily Sales'[retail_beans_revenue_gbp] )
			VAR Weighted =
			    Espresso * LOOKUPVALUE ( 'Realised Margin'[price_list_margin], 'Realised Margin'[product_category], "Espresso-Drinks" )
			        + FilterCoffee * LOOKUPVALUE ( 'Realised Margin'[price_list_margin], 'Realised Margin'[product_category], "Filter-Coffee" )
			        + Food * LOOKUPVALUE ( 'Realised Margin'[price_list_margin], 'Realised Margin'[product_category], "Food" )
			        + Beans * LOOKUPVALUE ( 'Realised Margin'[price_list_margin], 'Realised Margin'[product_category], "Retail-Beans" )
			RETURN DIVIDE ( Weighted, Espresso + FilterCoffee + Food + Beans ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Product
		lineageTag: 48cebcef-d87e-4143-b5ab-86070233ccf1

	/// Spend per visit for members, estimated by regression in the analysis repo (pooled). Does not
