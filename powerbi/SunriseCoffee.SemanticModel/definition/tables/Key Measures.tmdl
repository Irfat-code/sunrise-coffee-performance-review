table 'Key Measures'
	lineageTag: 3a5e8789-e81e-4953-b0ab-8817b4160fbb

	/// Total sales from the monthly P&L. Never from the daily sample, which is a 20% extract.
	measure Sales = SUM ( 'Monthly Profit'[total_monthly_revenue_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Money
		lineageTag: 146af02c-bd1a-407e-819d-703963c6eb35

	measure 'Net Profit' = SUM ( 'Monthly Profit'[net_profit_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Money
		lineageTag: a9ee953c-b682-4e64-bd7b-5fabcc6d1cc2

	measure 'Cost of Goods' = SUM ( 'Monthly Profit'[total_monthly_cogs_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Money
		lineageTag: 59997b9c-39a9-4b45-b173-c12d25b36db4

	measure 'Staff Cost' = SUM ( 'Monthly Profit'[monthly_staffing_cost_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Money
		lineageTag: 4da4d5b7-5f9c-4e8a-823b-e5652eb93e45

	measure Rent = SUM ( 'Monthly Profit'[monthly_rent_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Money
		lineageTag: e661ee22-489e-4de8-b1d4-9c5bd62e9055

	measure 'Loyalty Reward Cost' = SUM ( 'Monthly Profit'[loyalty_redemption_cost_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Money
		lineageTag: 630b8a2b-cc1a-49e9-accd-3bf97e0970a5

	measure 'Member Sales' = SUM ( 'Monthly Profit'[loyalty_member_spend_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Loyalty
		lineageTag: 545f3eec-f2b2-46bf-8ee4-a481c40377ea

	measure 'Non-member Sales' = SUM ( 'Monthly Profit'[non_member_spend_gbp] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Loyalty
		lineageTag: 989c562f-39c1-4789-b427-798b8495bdf3

	/// Net profit as a share of sales.
	measure 'Net Margin' = DIVIDE ( [Net Profit], [Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Money
		lineageTag: cd3bbf90-2984-4d57-927b-f22709e96ef9

	measure 'Store Count' = DISTINCTCOUNT ( 'Monthly Profit'[store_id] )
		formatString: #,0
		displayFolder: Stores
		lineageTag: 8ac8b555-1638-4b16-815b-d41ce403d7b4

	measure 'Profit per Store' = DIVIDE ( [Net Profit], [Store Count] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Stores
		lineageTag: 6a5979fe-71f3-40a2-9e75-6d4c578b2f7c

	measure 'Sales 2023' = CALCULATE ( [Sales], 'Date'[year] = 2023 )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Year
		lineageTag: ce46c0da-1a0a-4568-9031-e23c2e2ad506

	measure 'Net Profit 2023' = CALCULATE ( [Net Profit], 'Date'[year] = 2023 )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Year
		lineageTag: ff2b2a8a-fa78-44e6-ae87-293fe5468a0d

	measure 'Net Margin 2023' = DIVIDE ( [Net Profit 2023], [Sales 2023] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Year
		lineageTag: 0541e644-eee9-4198-876b-2b3f6ecce92c

	measure 'Sales 2024' = CALCULATE ( [Sales], 'Date'[year] = 2024 )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Year
		lineageTag: c74feaec-6d2b-46a6-959e-02e32a9b6d9c

	measure 'Net Profit 2024' = CALCULATE ( [Net Profit], 'Date'[year] = 2024 )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Year
		lineageTag: 3608cafa-182f-4d09-aa22-eb8f23a5f517

	measure 'Net Margin 2024' = DIVIDE ( [Net Profit 2024], [Sales 2024] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Year
		lineageTag: 66aa0008-66e8-4283-8988-e2dc6039c53a

	measure 'Sales vs 2023 %' = DIVIDE ( [Sales 2024] - [Sales 2023], [Sales 2023] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Year
		lineageTag: 3d16282c-f4f2-4028-8cc8-d455b7df00a9

	measure 'Profit vs 2023 %' = DIVIDE ( [Net Profit 2024] - [Net Profit 2023], [Net Profit 2023] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Year
		lineageTag: 5cdc7330-bffc-4182-b1f0-2db2f89ad8da

	/// Change in margin between 2023 and 2024, in percentage points.
	measure 'Margin Change pts' = ( [Net Margin 2024] - [Net Margin 2023] ) * 100
		formatString: 0.0;-0.0;0.0
		displayFolder: Year
		lineageTag: 0190b7fa-6034-4e94-ad8e-ed1a250d68d9

	measure 'Profit per Store 2024' = DIVIDE ( [Net Profit 2024], CALCULATE ( [Store Count], 'Date'[year] = 2024 ) )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Stores
		lineageTag: 9e3965c6-2b42-4342-8329-bfb363362438

	/// Net margin for all 60 stores, ignoring any store filter. Used as the benchmark line.
	measure 'Estate Net Margin' = CALCULATE ( [Net Margin], REMOVEFILTERS ( 'Store' ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Money
		lineageTag: a9d28778-c588-4335-8897-6a95d22d4874

	measure 'Margin vs Estate pts' = ( [Net Margin] - [Estate Net Margin] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Money
		lineageTag: 2d4b9bd2-b295-48f0-9422-30312aa544ec

	/// The middle store when all stores are ranked by margin (the median), so one unusual store cannot
	/// skew it.
	measure 'Typical Store Margin' = MEDIANX ( VALUES ( 'Store'[store_id] ), [Net Margin] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Stores
		lineageTag: c332219d-5a72-4527-a530-6a717d9bbb90

	measure 'Typical Store Sales' = MEDIANX ( VALUES ( 'Store'[store_id] ), [Sales] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Stores
		lineageTag: 1ffb9a10-ac39-465a-87b7-e2e9b4a4a20b

	measure 'Cost of Goods per £1' = DIVIDE ( [Cost of Goods], [Sales] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Pence per £1
		lineageTag: 12acd679-7ed0-4954-9f0d-0dc503c78c5d

	measure 'Staff per £1' = DIVIDE ( [Staff Cost], [Sales] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Pence per £1
		lineageTag: 2b7226c9-851f-4c4f-a897-0d3b38e2d999

	measure 'Rent per £1' = DIVIDE ( [Rent], [Sales] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Pence per £1
		lineageTag: 5ace4e22-1b92-4294-b036-86fd90c1a05b

	measure 'Loyalty per £1' = DIVIDE ( [Loyalty Reward Cost], [Sales] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Pence per £1
		lineageTag: 790875fc-6f15-4e39-922f-d058d9a688dd

	measure 'Profit per £1' = DIVIDE ( [Net Profit], [Sales] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Pence per £1
		lineageTag: fc32778d-4512-4e48-9b39-d9d76a50c5c8

	measure 'Rent % of Sales' = DIVIDE ( [Rent], [Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Rent
		lineageTag: fef88caf-d5e3-4c42-a400-b514b55851e7

	measure 'Stores Over 10% Rent' = COUNTROWS ( FILTER ( VALUES ( 'Store'[store_id] ), [Rent % of Sales] > 0.10 ) ) + 0
		formatString: #,0
		displayFolder: Rent
		lineageTag: 5a4424aa-cf61-4861-aa06-cf798d6a97ba

	measure 'Stores Under 8% Margin' = COUNTROWS ( FILTER ( VALUES ( 'Store'[store_id] ), [Net Margin] < 0.08 ) ) + 0
		formatString: #,0
		displayFolder: Stores
		lineageTag: b3094201-c71b-4407-a257-6d8a770c0980

	measure 'Stores Losing Money' = COUNTROWS ( FILTER ( VALUES ( 'Store'[store_id] ), [Net Profit 2024] < 0 ) ) + 0
		formatString: #,0
		displayFolder: Stores
		lineageTag: 5a3b28ca-82f7-4fcb-8983-9758f5b82c36

	measure 'Stores to Review' = CALCULATE ( [Store Count], 'Store'[Review Status] IN { "Review", "Losing money" } ) + 0
		formatString: #,0
		displayFolder: Stores
		lineageTag: b7751cd2-933a-4250-875e-3457b4ba163b

	/// A month counts as losing money when its margin is below −2%.
	measure 'Months Losing Money per Store' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'Monthly Profit' ), 'Monthly Profit'[net_profit_margin_pct] < -0.02 ),
			    [Store Count]
			)
		formatString: #,0.0
		displayFolder: Stores
		lineageTag: 4483d20f-f8ff-4eb4-a25a-d5c600df57da

	/// Spend per member visit. Uses the 20% daily sample for visits, compared within each store.
	measure 'Member Spend per Visit' =
			VAR Visits = SUM ( 'Daily Sales'[loyalty_transactions] )
			VAR MemberShare = DIVIDE ( [Member Sales], [Sales] )
			RETURN DIVIDE ( SUM ( 'Daily Sales'[total_revenue_gbp] ) * MemberShare, Visits )
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		displayFolder: Loyalty
		lineageTag: bb77193f-b0c4-4142-b716-7c051660572c

	measure 'Members Share of Sales' = DIVIDE ( [Member Sales], [Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Loyalty
		lineageTag: 151d02f0-96ad-4f40-9485-c2d5b0a02ef4

	measure 'Customers in Scheme' = AVERAGEX ( VALUES ( 'Store'[store_id] ), CALCULATE ( MAX ( 'Store'[loyalty_adoption_rate] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Loyalty
		lineageTag: 1ba8074d-5f09-405a-8707-ab0e41a89ac4

	measure 'Reward Cost % of Member Sales' = DIVIDE ( [Loyalty Reward Cost], [Member Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Loyalty
		lineageTag: 4297af5d-3eb8-424b-ae3e-b1c06de49f36

	measure 'Reward Cost per Store' = DIVIDE ( CALCULATE ( [Loyalty Reward Cost], 'Date'[year] = 2024 ), CALCULATE ( [Store Count], 'Date'[year] = 2024 ) )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Loyalty
		lineageTag: f1838fac-9885-4660-9dfb-010c30f2e49a

	measure 'Reward Cost % of Net Profit' = DIVIDE ( [Loyalty Reward Cost], [Net Profit] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Loyalty
		lineageTag: 03114bc3-f95c-427e-af9d-761377660d9a

	/// Extra member sales needed to cover the reward cost. No uplift of this size is visible in the
	/// data.
	measure 'Uplift Needed to Break Even' = DIVIDE ( [Loyalty Reward Cost], [Member Sales] - [Loyalty Reward Cost] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Loyalty
		lineageTag: a0cbdd85-03c1-40f0-969c-ebca51fa5a2e

	measure 'Extra Member Sales Needed' = [Member Sales] * [Uplift Needed to Break Even]
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Loyalty
		lineageTag: 6e61fd61-aaac-4c24-bd66-69e221411c41

	/// 1.00 means members spend the same as everyone else. Above 1.00 would mean members spend more.
	measure 'Member Spend Index' =
			VAR MemberShareOfSales = DIVIDE ( [Member Sales], [Sales] )
			VAR MemberShareOfVisits =
			    DIVIDE ( SUM ( 'Daily Sales'[loyalty_transactions] ), SUM ( 'Daily Sales'[total_transactions] ) )
			RETURN DIVIDE ( MemberShareOfSales, MemberShareOfVisits )
		formatString: 0.00
		displayFolder: Loyalty
		lineageTag: baf3ff1a-ccf2-45a3-902e-7dca388893b8

	/// 100 = that store's own average day. Compared within each store, so store size does not distort
	/// it.
	measure 'Sales Index vs Average Day' =
			VAR PerStore =
			    AVERAGEX (
			        VALUES ( 'Store'[store_id] ),
			        VAR StoreAverage =
			            CALCULATE ( AVERAGE ( 'Daily Sales'[total_revenue_gbp] ), REMOVEFILTERS ( 'Date' ) )
			        RETURN DIVIDE ( AVERAGE ( 'Daily Sales'[total_revenue_gbp] ), StoreAverage )
			    )
			RETURN PerStore * 100
		formatString: #,0
		displayFolder: Day of week
		lineageTag: 30d21db6-95c2-4391-8d0f-18a3360381d3

	measure 'Staff Hours Index vs Average Day' =
			VAR PerStore =
			    AVERAGEX (
			        VALUES ( 'Store'[store_id] ),
			        VAR StoreAverage =
			            CALCULATE ( AVERAGE ( 'Daily Sales'[total_staff_hours] ), REMOVEFILTERS ( 'Date' ) )
			        RETURN DIVIDE ( AVERAGE ( 'Daily Sales'[total_staff_hours] ), StoreAverage )
			    )
			RETURN PerStore * 100
		formatString: #,0
		displayFolder: Day of week
		lineageTag: d81117ed-9007-4c98-b958-3898fdea4dec

	measure 'Weekend vs Weekday %' =
			VAR Weekend = CALCULATE ( [Sales Index vs Average Day], 'Date'[is_weekend] = TRUE () )
			VAR Weekday = CALCULATE ( [Sales Index vs Average Day], 'Date'[is_weekend] = FALSE () )
			RETURN DIVIDE ( Weekend - Weekday, Weekday )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Day of week
		lineageTag: 658fdf82-5930-4059-afda-ea28e90473cc

	/// Gross profit actually kept from each £1 of sales, from the daily sample.
	measure 'Profit Kept per £1' =
			DIVIDE (
			    SUM ( 'Daily Sales'[daily_gross_profit_gbp] ),
			    SUM ( 'Daily Sales'[total_revenue_gbp] )
			) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Product
		lineageTag: 9d1fed6c-c7d8-4b50-98c5-bbdbc4c076d7

	measure 'Price List Margin' = AVERAGE ( 'Realised Margin'[price_list_margin] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Product
		lineageTag: 4ddb208d-5b67-48a1-9008-3cf53f4fc863

	/// Gross profit kept per £1, estimated per stream by regressing daily gross profit on stream
	/// revenue.
	measure 'Realised Margin' = AVERAGE ( 'Realised Margin'[realised_margin] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Product
		lineageTag: daebc256-0e22-4dcb-a384-44afb3816c48

	measure 'Espresso Drinks Share' = DIVIDE ( SUM ( 'Daily Sales'[espresso_revenue_gbp] ), SUM ( 'Daily Sales'[total_revenue_gbp] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Product
		lineageTag: 1c27e09d-6d57-47ad-9fb0-998559e3fe5f

	measure 'Filter Coffee Share' = DIVIDE ( SUM ( 'Daily Sales'[filter_revenue_gbp] ), SUM ( 'Daily Sales'[total_revenue_gbp] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Product
		lineageTag: a2cf9afe-9b65-4822-8688-969e894fb750

	measure 'Food Share' = DIVIDE ( SUM ( 'Daily Sales'[food_revenue_gbp] ), SUM ( 'Daily Sales'[total_revenue_gbp] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Product
		lineageTag: d0ce592c-f928-4d52-a272-7381a5a5bfeb

	measure 'Retail Beans Share' = DIVIDE ( SUM ( 'Daily Sales'[retail_beans_revenue_gbp] ), SUM ( 'Daily Sales'[total_revenue_gbp] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Product
		lineageTag: 3120abd3-4b8e-4a74-beef-977d07b393b8

	/// Profit a year if London stores earned the estate median margin. From the analysis repo.
	measure 'London Rent Opportunity' = 563305
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: At stake
		lineageTag: 4912321a-1220-49a8-ae13-d8c4c19e085d

	/// 2024 reward cost that is at risk if the test shows no uplift.
	measure 'Loyalty Reward at Stake' = 862937
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: At stake
		lineageTag: d6d1e48e-1b0f-488f-9f66-55c76ea42d9c

	/// Upper bound if weekend hours matched weekday productivity, before minimum crew levels.
	measure 'Weekend Staffing Opportunity' = 971558
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: At stake
		lineageTag: 779685ae-01dc-4566-ad4d-9019d41f7344

	measure 'Total at Stake' = [London Rent Opportunity] + [Loyalty Reward at Stake] + [Weekend Staffing Opportunity]
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: At stake
		lineageTag: f06cf139-cdfd-467d-884f-844ecda529ed

	/// Follows the Net Profit / Net Margin / Sales buttons on the Overview page.
	measure 'Selected Measure' =
			VAR Chosen = SELECTEDVALUE ( 'Measure Choice'[Measure Choice Order], 0 )
			RETURN
			    SWITCH (
			        Chosen,
			        0, [Net Profit],
			        1, [Net Margin],
			        2, [Sales]
			    )
		displayFolder: Pence per £1
		lineageTag: c9437358-80cc-4883-993c-80c59c75beae

		formatStringDefinition =
				IF (
				    SELECTEDVALUE ( 'Measure Choice'[Measure Choice] ) = "Net Margin",
				    "0.0%",
				    "£#,0"
				)

	/// The middle store of all 60 in that month, used as the comparison line on the Store Deep Dive
	/// page.
	measure 'Typical Store Profit' = MEDIANX ( VALUES ( 'Store'[store_id] ), [Net Profit] )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Stores
		lineageTag: 876c85f3-2953-4c7f-a5fc-384ff8c3ff63

	measure 'Pence per £1' =
			VAR Part = SELECTEDVALUE ( 'Pound Split'[Part] )
			VAR Amount =
			    SWITCH (
			        Part,
			        "Cost of goods", [Cost of Goods],
			        "Staff", [Staff Cost],
			        "Rent", [Rent],
			        "Loyalty", [Loyalty Reward Cost],
			        "Profit", [Net Profit]
			    )
			RETURN DIVIDE ( Amount, [Sales] ) * 100
		formatString: 0"p";-0"p";0"p"
		displayFolder: Pence per £1
		lineageTag: bb133438-924a-4d22-85cc-4deaf2c30b5b

	/// The same pence split for all 60 stores, so a single store can be compared with the estate.
	measure 'Estate Pence per £1' = CALCULATE ( [Pence per £1], REMOVEFILTERS ( 'Store' ) )
		formatString: 0"p";-0"p";0"p"
		displayFolder: Pence per £1
		lineageTag: 630dfff5-8eae-4367-ad8e-d58585f59c5d

	measure 'Pound Amount' =
			VAR Part = SELECTEDVALUE ( 'Pound Split'[Part] )
			RETURN
			    SWITCH (
			        Part,
			        "Cost of goods", [Cost of Goods],
			        "Staff", [Staff Cost],
			        "Rent", [Rent],
			        "Loyalty", [Loyalty Reward Cost],
			        "Profit", [Net Profit]
			    )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Pence per £1
		lineageTag: 78e753da-eeba-478a-bc7c-93594d07d344

	/// The year picked in the Year slicer, or the latest year when none is picked.
	measure 'Selected Year' = MAX ( 'Date'[year] )
		formatString: 0
		displayFolder: Selected year
		lineageTag: 18d68d56-53ca-4dee-9b48-c96a8e54b014

	measure 'Year Sales' =
			VAR y = [Selected Year]
			RETURN CALCULATE ( [Sales], 'Date'[year] = y )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Selected year
		lineageTag: c9460520-4dc2-479e-8bc8-f0e32096a2d3

	measure 'Year Net Profit' =
			VAR y = [Selected Year]
			RETURN CALCULATE ( [Net Profit], 'Date'[year] = y )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Selected year
		lineageTag: 4c8b9d3a-6662-4b48-8aa7-a098bf0ff94e

	measure 'Year Rent' =
			VAR y = [Selected Year]
			RETURN CALCULATE ( [Rent], 'Date'[year] = y )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Selected year
		lineageTag: f3f4bd0e-cae6-424b-9726-dbf71f187ae3

	measure 'Year Loyalty Reward Cost' =
			VAR y = [Selected Year]
			RETURN CALCULATE ( [Loyalty Reward Cost], 'Date'[year] = y )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Selected year
		lineageTag: 2888fdeb-dc29-42e2-8360-65dcc916024f

	measure 'Year Store Count' =
			VAR y = [Selected Year]
			RETURN CALCULATE ( [Store Count], 'Date'[year] = y )
		formatString: #,0
		displayFolder: Selected year
		lineageTag: 6e7561dd-d466-425d-93e0-bcb552162dbc

	measure 'Prior Year Sales' =
			VAR y = [Selected Year] - 1
			RETURN CALCULATE ( [Sales], 'Date'[year] = y )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Selected year
		lineageTag: 49f57e10-c40a-42f4-8e05-ffc36b34ae9a

	measure 'Prior Year Net Profit' =
			VAR y = [Selected Year] - 1
			RETURN CALCULATE ( [Net Profit], 'Date'[year] = y )
		formatString: \£#,0;(\£#,0);\£#,0
		displayFolder: Selected year
		lineageTag: 1021b765-502e-4a4b-b8ac-eb7d554f3fae

	measure 'Year Net Margin' = DIVIDE ( [Year Net Profit], [Year Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Selected year
		lineageTag: 6087e9a4-1ba6-473b-8402-ab61acf182e6

	measure 'Prior Year Net Margin' = DIVIDE ( [Prior Year Net Profit], [Prior Year Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Selected year
		lineageTag: 37aa0d58-059b-485c-a143-372d328b9d3d

	measure 'Year Profit per Store' = DIVIDE ( [Year Net Profit], [Year Store Count] )
