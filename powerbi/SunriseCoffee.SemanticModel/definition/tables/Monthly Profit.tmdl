	partition 'Monthly Profit' = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "fact_store_monthly_profitability.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"monthly_profit_id", Int64.Type}, {"store_id", Int64.Type}, {"date_id", Int64.Type}, {"month_id", type text}, {"total_monthly_revenue_gbp", type number}, {"total_monthly_cogs_gbp", type number}, {"monthly_rent_gbp", type number}, {"monthly_staffing_cost_gbp", type number}, {"loyalty_redemption_cost_gbp", type number}, {"net_profit_gbp", type number}, {"net_profit_margin_pct", type number}, {"avg_daily_footfall", type number}, {"loyalty_member_revenue_pct", type number}, {"loyalty_member_spend_gbp", type number}, {"non_member_spend_gbp", type number}, {"revenue_per_sqft_gbp", type number}, {"peak_hour_transactions", Int64.Type}, {"dead_hour_transactions", Int64.Type}, {"avg_dwell_time_minutes", type number}, {"rent_band", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

