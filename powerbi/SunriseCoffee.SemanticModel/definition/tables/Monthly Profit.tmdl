	column 'Profit Status' =
			SWITCH (
			    TRUE (),
			    'Monthly Profit'[net_profit_margin_pct] < -0.02, "Loss-making",
			    'Monthly Profit'[net_profit_margin_pct] < 0.02, "Break-even",
			    'Monthly Profit'[net_profit_margin_pct] < 0.15, "Profitable",
			    "Highly profitable"
			)
		dataType: string
